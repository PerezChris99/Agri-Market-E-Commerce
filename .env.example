# Django\nDJANGO_SECRET_KEY=replace-with-a-long-random-secret\nDJANGO_DEBUG=False\nALLOWED_HOSTS=localhost,127.0.0.1\nCSRF_TRUSTED_ORIGINS=http://localhost:8000\nSECURE_SSL_REDIRECT=False\n\n# Database\n# Development may omit this and use local SQLite. Production MUST set PostgreSQL.\nDATABASE_URL=postgresql://user:password@localhost:5432/agrimarket\n\n# PayPal\nPAYPAL_CLIENT_ID=\nPAYPAL_CLIENT_SECRET=\nPAYPAL_MODE=sandbox\n\n# MTN Mobile Money\nMTN_MOMO_API_USER=\nMTN_MOMO_API_KEY=\nMTN_MOMO_SUBSCRIPTION_KEY=\nMTN_MOMO_ENVIRONMENT=sandbox\nMTN_MOMO_CALLBACK_URL=https://example.com/api/momo/callback/\n\n# Airtel Money\nAIRTEL_CLIENT_ID=\nAIRTEL_CLIENT_SECRET=\nAIRTEL_ENVIRONMENT=sandbox\nAIRTEL_CALLBACK_URL=https://example.com/api/momo/callback/\n\n# Flutterwave\nFLUTTERWAVE_PUBLIC_KEY=\nFLUTTERWAVE_SECRET_KEY=\nFLUTTERWAVE_ENCRYPTION_KEY=\nFLUTTERWAVE_ENVIRONMENT=sandbox\nFLUTTERWAVE_REDIRECT_URL=https://example.com/checkout/complete/\nMOBILE_MONEY_PROVIDER=flutterwave\n\n# SMS\nSMS_PROVIDER=africastalking\nAT_USERNAME=sandbox\nAT_API_KEY=\nAT_SENDER_ID=AgriMarket\nTWILIO_ACCOUNT_SID=\nTWILIO_AUTH_TOKEN=\nTWILIO_PHONE_NUMBER=\n\n# WhatsApp\nWHATSAPP_PHONE_ID=\nWHATSAPP_ACCESS_TOKEN=\nWHATSAPP_VERIFY_TOKEN=replace-me\nWHATSAPP_BUSINESS_ACCOUNT_ID=\n\n# Delivery\nDEFAULT_DELIVERY_FEE=5000\nFREE_DELIVERY_THRESHOLD=100000\n\n# Site\nUSD_TO_UGX_RATE=3700\nSUPPORT_EMAIL=support@agrimarket.ug\nSUPPORT_PHONE=+256700000000\nSUPPORT_WHATSAPP=+256700000000\n