# Django Settings
# Generate a new secret key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True

# PayPal Configuration (Sandbox for development, Live for production)
PAYPAL_CLIENT_ID=your-paypal-client-id-here

# Database (optional - defaults to SQLite)
# DATABASE_URL=postgres://user:password@localhost:5432/dbname

# Allowed Hosts (comma-separated for production)
# ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
